{
  "name": "budgetbuddy",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "vite build",
    "start": "node server/server.js",
    "dev": "concurrently \"node server/server.js\" \"vite\"",
    "test": "jest --forceExit --detectOpenHandles",
    "test:server": "jest server/tests --forceExit --detectOpenHandles",
    "test:client": "jest client/src --forceExit --detectOpenHandles"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "pg": "^8.11.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "chart.js": "^4.4.1",
    "react-chartjs-2": "^5.2.0",
    "axios": "^1.6.5",
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^5.0.12",
    "tailwindcss": "^3.4.1",
    "postcss": "^8.4.33",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "@testing-library/react": "^14.2.1",
    "@testing-library/jest-dom": "^6.4.2",
    "jest-environment-jsdom": "^29.7.0",
    "babel-jest": "^29.7.0",
    "@babel/core": "^7.23.9",
    "@babel/preset-env": "^7.23.9",
    "@babel/preset-react": "^7.23.3"
  },
  "optionalDependencies": {
    "better-sqlite3": "^9.4.3"
  },
  "jest": {
    "projects": [
      {
        "displayName": "server",
        "testEnvironment": "node",
        "testMatch": ["<rootDir>/server/tests/**/*.test.js"]
      },
      {
        "displayName": "client",
        "testEnvironment": "jsdom",
        "testMatch": ["<rootDir>/client/src/**/*.test.jsx"],
        "moduleNameMapper": {
          "\\.css$": "<rootDir>/client/src/__mocks__/styleMock.js"
        },
        "transform": {
          "^.+\\.jsx?$": "babel-jest"
        }
      }
    ]
  }
}
